# One connection string — swap the value to move between providers, no code change:
#   Neon     -> use the POOLED connection string (host ends in "-pooler")
#   Supabase -> Project Settings -> Database -> Connection string (Session pooler)
#   Local    -> postgresql://postgres:postgres@localhost:5432/postgres
DATABASE_URL=postgresql://user:password@host/dbname

# Accounts live in the database (users table). Login is by password only (no
# email); each account needs a unique password. No public signup — create
# accounts with:
#   npm run user:create -- "Liam" "a-strong-password"

# Secret used to sign the session cookie. Generate a long random value with:
#   openssl rand -base64 32
#   PowerShell (no openssl):  $b=New-Object byte[] 32; ([System.Security.Cryptography.RNGCryptoServiceProvider]::new()).GetBytes($b); [Convert]::ToBase64String($b)
APP_SECRET=replace-me-with-a-long-random-string
